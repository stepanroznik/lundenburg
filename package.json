{
  "name": "lundenburg-kids-premium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wall-clock-authoritative playout and DVB-T scheduling for Lundenburg Kids Premium",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lkp": "tsx src/cli.ts",
    "media:scan": "npm run lkp -- media scan",
    "schedule:generate": "npm run lkp -- schedule generate",
    "schedule:show": "npm run lkp -- schedule show",
    "schedule:export": "npm run lkp -- schedule export",
    "broadcast:start": "npm run lkp -- broadcast start",
    "internet:start": "tsx src/internet.ts",
    "doctor": "npm run lkp -- doctor",
    "weather:map": "tsx src/weather/cli.ts map",
    "weather:fetch": "tsx src/weather/cli.ts fetch",
    "weather:generate": "tsx src/weather/cli.ts generate",
    "weather:preview": "tsx src/weather/cli.ts generate --fixture mixed --audio silent",
    "weather:render": "tsx src/weather/cli.ts render",
    "weather:publish": "tsx src/weather/cli.ts publish",
    "weather:auto": "tsx src/weather/cli.ts auto",
    "weather:usage": "tsx src/weather/cli.ts usage",
    "intermissions:list": "tsx src/intermissions/cli.ts list",
    "intermissions:prepare": "tsx src/intermissions/cli.ts prepare",
    "intermissions:render": "tsx src/intermissions/cli.ts render",
    "intermissions:stills": "tsx src/intermissions/cli.ts render --stills --scale .5",
    "intermissions:publish": "tsx src/intermissions/cli.ts publish",
    "intermissions:gallery": "tsx src/intermissions/cli.ts gallery",
    "intermissions:finish": "bash scripts/finish-intermissions-pi.sh"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.1",
    "exceljs": "^4.4.0",
    "hls.js": "1.7.3",
    "luxon": "^3.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.526",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

[Unit]
Description=Prepare and schedule the due LKP weather edition
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lundenburg
WorkingDirectory=/home/lundenburg/lkp-weather
EnvironmentFile=-/etc/lkp-weather.env
Environment=WEATHER_RENDER_CONCURRENCY=1
ExecStart=/usr/bin/npm run weather:auto
TimeoutStartSec=5400
Nice=19
CPUSchedulingPolicy=idle
CPUWeight=1
CPUQuota=100%
# Playout uses cores 0-1; reserve cores 2-3 for GNU Radio/HackRF.
# SCHED_IDLE makes rendering yield to normal-priority playout on 0-1.
CPUAffinity=0 1
AllowedCPUs=0-1
IOWeight=1
IOSchedulingClass=idle
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true

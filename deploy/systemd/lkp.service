[Unit]
Description=Lundenburg Kids Premium playout
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
User=lundenburg
Group=lundenburg
WorkingDirectory=/home/lundenburg/lundenburg
Environment=NODE_ENV=production
EnvironmentFile=-/etc/lkp.env
ExecStartPre=/usr/bin/npm run doctor
ExecStart=/usr/bin/node --import tsx src/cli.ts broadcast start --i-understand-rf
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
